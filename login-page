```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Myntra Login Demo</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f6;
        }

        /* Navigation bar */
        .navbar {
            height: 75px;
            background: white;
            display: flex;
            align-items: center;
            padding: 0 8%;
            box-shadow: 0 2px 8px #00000010;
        }

        .logo {
            font-size: 32px;
            font-weight: bold;
            color: #ff3f6c;
            margin-right: 40px;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            font-size: 13px;
            font-weight: bold;
            color: #282c3f;
        }

        /* Login section */
        .container {
            min-height: calc(100vh - 75px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 15px;
        }

        .login-card {
            width: 380px;
            max-width: 100%;
            background: white;
            padding: 35px 30px;
            border-radius: 5px;
            box-shadow: 0 5px 25px #0000000d;
        }

        .banner {
            height: 120px;
            border-radius: 5px;
            background: linear-gradient(135deg, #fff0f4, #ffe0e9);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 45px;
            margin-bottom: 25px;
        }

        h2 {
            color: #282c3f;
            font-size: 20px;
            margin-bottom: 25px;
        }

        h2 span {
            font-size: 15px;
            font-weight: normal;
        }

        .input-group {
            display: flex;
            border: 1px solid #d4d5d9;
            border-radius: 3px;
            height: 48px;
            align-items: center;
            overflow: hidden;
        }

        .country-code {
            padding: 0 12px;
            border-right: 1px solid #d4d5d9;
            color: #282c3f;
        }

        input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            padding: 12px;
            font-size: 14px;
        }

        .terms {
            font-size: 12px;
            color: #535766;
            line-height: 1.8;
            margin-top: 20px;
        }

        .terms strong {
            color: #ff3f6c;
        }

        .continue-btn {
            width: 100%;
            padding: 14px;
            margin-top: 20px;
            border: none;
            border-radius: 3px;
            background: #ff3f6c;
            color: white;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

        .continue-btn:hover {
            background: #e8325d;
        }

        .help {
            margin-top: 25px;
            font-size: 13px;
            color: #535766;
        }

        .help strong {
            color: #ff3f6c;
        }

        #message {
            color: #d93025;
            font-size: 12px;
            margin-top: 12px;
        }

        @media (max-width: 600px) {
            .navbar {
                height: 60px;
                padding: 0 20px;
            }

            .logo {
                margin-right: 20px;
            }

            .nav-links {
                gap: 12px;
                font-size: 10px;
            }

            .login-card {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>

    <header class="navbar">
        <div class="logo">M</div>

        <nav class="nav-links">
            <span>MEN</span>
            <span>WOMEN</span>
            <span>KIDS</span>
            <span>HOME</span>
        </nav>
    </header>

    <main class="container">

        <section class="login-card">

            <div class="banner">🛍️</div>

            <h2>Login <span>or Signup</span></h2>

            <form id="loginForm">

                <div class="input-group">
                    <span class="country-code">+91</span>

                    <input
                        type="tel"
                        id="mobile"
                        placeholder="Mobile Number"
                        maxlength="10"
                        pattern="[0-9]{10}"
                        required
                    >
                </div>

                <p class="terms">
                    By continuing, I agree to the
                    <strong>Terms of Use</strong> and
                    <strong>Privacy Policy</strong>.
                </p>

                <button class="continue-btn" type="submit">
                    CONTINUE
                </button>

                <p id="message" role="status"></p>

            </form>

            <div class="help">
                Have trouble logging in?
                <strong>Get Help</strong>
            </div>

        </section>

    </main>

    <script>
        document.getElementById("loginForm")
            .addEventListener("submit", function(event) {

                event.preventDefault();

                const mobile =
                    document.getElementById("mobile").value;

                if (!/^[0-9]{10}$/.test(mobile)) {
                    document.getElementById("message").textContent =
                        "Please enter a valid 10-digit mobile number.";
                    return;
                }

                document.getElementById("message").textContent =
                    "Demo only: authentication is not connected.";
            });
    </script>

</body>
</html>
```
